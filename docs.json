{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Recivu API",
  "description": "Turn Italian fiscal receipts into electronic invoices and recover the VAT.",
  "colors": {
    "primary": "#0D6760",
    "light": "#8FC7A3",
    "dark": "#0D6760"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://recivu.it"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "authentication", "sandbox"]
          },
          {
            "group": "Integration",
            "pages": ["webhooks", "rate-limiting", "errors"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.yaml"
      },
      {
        "tab": "Changelog",
        "pages": ["changelog"]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "go"]
    }
  },
  "seo": {
    "metatags": {
      "robots": "noindex"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "recivu.it",
        "href": "https://recivu.it"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "website": "https://recivu.it"
    }
  }
}
